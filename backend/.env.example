# Backend environment variables
API_PORT=8000
API_TOKEN=devtoken
# SQLite (local run without Docker)
DATABASE_URL=sqlite:///./solar_monitoring.db
# Docker Compose sets DATABASE_URL to the PostgreSQL service (see docker-compose.yml)

# WebSocket toggle
WS_ENABLED=true

# Optional Blynk integration
# BLYNK_TOKEN=
# VPIN_V=1
# VPIN_I=2
# VPIN_T=3
